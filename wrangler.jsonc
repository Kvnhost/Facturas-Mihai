{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "facturas-mihai",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rgl-mihai-db",
      "database_id": "8300e662-fcae-40f7-bbd7-7952ed9db7b2"
    }
  ]
}
